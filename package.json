{
  "name": "dsh-wb-memory",
  "version": "0.13.0",
  "description": "把 WorkBuddy 的文件化记忆机制带入 DeepSeek Harness：分层注入（全局画像 + 工作区置顶 PINNED + 摘要/相关条目 + 今日日志 + 近 N 日回顾）；记忆源为各 dsh 工作区 .workbuddy/memory/，纯 Markdown 无向量库；含 auto-digest 流水记录、会话收尾小结、auto-distill 日志提炼、memory_search 原生工具（长期记忆+近期日志双源检索）、超阈值 LLM 整理（同轮反馈重试）与 TTL/回收站治理，并在设置面板提供管理界面。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "scripts": {
    "test": "node test/run.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "memory",
    "workbuddy"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "test/*.mjs",
    "test/fixtures/host-claims.json",
    "test/fixtures/recall-eval-cases.json",
    "test/fixtures/retrieve-v010-legacy.mjs",
    "test/fixtures/retrieve-before-panel.mjs",
    "test/fixtures/wsroot/**/MEMORY.md",
    "cordis.patch.yml",
    "README.md",
    "config.example.json",
    "assets/readme/*.svg",
    "import-wb-memory.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miseryrua/dsh-wb-memory.git"
  },
  "homepage": "https://github.com/miseryrua/dsh-wb-memory#readme",
  "bugs": {
    "url": "https://github.com/miseryrua/dsh-wb-memory/issues"
  }
}
